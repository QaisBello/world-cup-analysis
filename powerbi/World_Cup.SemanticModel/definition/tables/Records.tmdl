/// Highest-scoring matches and biggest margins.
table Records

	column list
		dataType: string
		summarizeBy: none
		sourceColumn: list

	column sex
		dataType: string
		summarizeBy: none
		sourceColumn: sex

	column tournament_name
		dataType: string
		summarizeBy: none
		sourceColumn: tournament_name

	column match_date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: match_date

	column stage_name
		dataType: string
		summarizeBy: none
		sourceColumn: stage_name

	column home_team_name
		dataType: string
		summarizeBy: none
		sourceColumn: home_team_name

	column home_team_score
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: home_team_score

	column away_team_score
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: away_team_score

	column away_team_name
		dataType: string
		summarizeBy: none
		sourceColumn: away_team_name

	column total
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: total

	column margin
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: margin

	column extra_time
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: extra_time

	partition Records = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "top_matches.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"list", type text},
				            {"sex", type text},
				            {"tournament_name", type text},
				            {"match_date", type datetime},
				            {"stage_name", type text},
				            {"home_team_name", type text},
				            {"home_team_score", Int64.Type},
				            {"away_team_score", Int64.Type},
				            {"away_team_name", type text},
				            {"total", Int64.Type},
				            {"margin", Int64.Type},
				            {"extra_time", Int64.Type}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

