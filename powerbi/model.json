  "measures": [
    {
      "name": "Total Goals",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "#,0",
      "dax": "SUM ( 'Goal Minutes'[goals] )",
      "description": "Goals scored, all periods."
    },
    {
      "name": "Normal-Time Goals",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "#,0",
      "dax": "CALCULATE ( [Total Goals], 'Goal Minutes'[Normal Time] == TRUE () )",
      "description": "Goals in the 90 minutes plus stoppage time."
    },
    {
      "name": "Share of Normal-Time Goals",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "0%",
      "dax": "DIVIDE (\n    [Normal-Time Goals],\n    CALCULATE ( [Normal-Time Goals], REMOVEFILTERS ( 'Goal Minutes'[Quarter-hour], 'Goal Minutes'[Band Order] ) )\n)",
      "description": "Share of normal-time goals in each quarter-hour (an even spread would be 17% each)."
    },
    {
      "name": "Even Spread",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "0%",
      "dax": "1 / 6",
      "description": "Reference line: one sixth of goals per quarter-hour."
    },
    {
      "name": "Last 15 Minutes Share",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "0%",
      "dax": "DIVIDE (\n    CALCULATE ( [Normal-Time Goals], 'Goal Minutes'[Band Order] = 6 ),\n    [Normal-Time Goals]\n)",
      "description": "Share of normal-time goals from the 76th minute on, including stoppage time."
    },
    {
      "name": "First 15 Minutes Share",
      "table": "Goal Minutes",
      "folder": "Goals",
      "format": "0%",
      "dax": "DIVIDE ( CALCULATE ( [Normal-Time Goals], 'Goal Minutes'[Band Order] = 1 ), [Normal-Time Goals] )",
      "description": "Share of normal-time goals in the opening 15 minutes."
    },
    {
      "name": "Tournaments Count",
      "table": "Tournaments",
      "folder": "Tournaments",
      "format": "#,0",
      "dax": "COUNTROWS ( Tournaments )",
      "description": "Tournaments in context."
    },
    {
      "name": "Matches Played",
      "table": "Tournaments",
      "folder": "Tournaments",
      "format": "#,0",
      "dax": "SUM ( Tournaments[matches] )",
      "description": "Matches played."
    },
    {
      "name": "Goals per Match",
      "table": "Tournaments",
      "folder": "Tournaments",
      "format": "0.00",
      "dax": "DIVIDE ( SUM ( Tournaments[goals] ), [Matches Played] )",
      "description": "Goals per match."
    },
    {
      "name": "Hosts Who Won",
      "table": "Tournaments",
      "folder": "Hosts",
      "format": "#,0",
      "dax": "SUM ( Tournaments[host_won] )",
      "description": "Tournaments won by the host."
    },
    {
      "name": "Hosts in Last Four",
      "table": "Tournaments",
      "folder": "Hosts",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Tournaments ), Tournaments[host_result] IN { \"champions\", \"runners-up\", \"third place\", \"fourth place\" } )",
      "description": "Hosts that reached the semi-finals."
    },
    {
      "name": "Average Teams",
      "table": "Tournaments",
      "folder": "Hosts",
      "format": "0",
      "dax": "AVERAGE ( Tournaments[count_teams] )",
      "description": "Teams per tournament (a random team's chance of winning is about 1 in this)."
    },
    {
      "name": "Appearances",
      "table": "Teams",
      "folder": "Nations",
      "format": "#,0",
      "dax": "COUNTROWS ( Teams )",
      "description": "Tournaments played."
    },
    {
      "name": "Titles",
      "table": "Teams",
      "folder": "Nations",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Teams ), Teams[champion] == TRUE () ) + 0",
      "description": "World Cups won."
    },
    {
      "name": "Wins",
      "table": "Teams",
      "folder": "Nations",
      "format": "#,0",
      "dax": "SUM ( Teams[won] )",
      "description": "Matches won."
    },
    {
      "name": "Goal Difference",
      "table": "Teams",
      "folder": "Nations",
      "format": "+#,0;-#,0;0",
      "dax": "SUM ( Teams[goals_for] ) - SUM ( Teams[goals_against] )",
      "description": "Goals for minus against."
    }
  ],
